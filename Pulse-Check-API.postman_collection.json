				{
					"name": "3. Send Heartbeat Ping",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Heartbeat reset the countdown timer\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"Heartbeat received. Timer reset.\");",
									"    pm.expect(jsonData.monitor.status).to.eql(\"active\");",
									"    pm.expect(jsonData.monitor.last_ping).to.be.a(\"number\");",
									"    pm.expect(jsonData.monitor.expires_at).to.be.a(\"number\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
