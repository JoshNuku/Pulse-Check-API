						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/monitors/{{deviceId}}/pause",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monitors",
								"{{deviceId}}",
								"pause"
							]
						},
						"description": "Freezes the countdown timer for the monitor, preventing false alert triggers during scheduled maintenance."
					}
				},
				{
					"name": "5. Resume Monitor (via Heartbeat)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Heartbeat successfully unpaused and resumed the monitor\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"Heartbeat received. Timer reset.\");",
									"    pm.expect(jsonData.monitor.status).to.eql(\"active\");",
									"    pm.expect(jsonData.monitor.paused_remaining_ms).to.be.null;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/monitors/{{deviceId}}/heartbeat",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monitors",
								"{{deviceId}}",
								"heartbeat"
							]
						},
						"description": "Sending a heartbeat ping to a paused monitor automatically un-pauses it and restores active monitoring."
					}
				},
				{
					"name": "6. Get All Monitors",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is an array containing registered devices\", function () {",
									"    var jsonData = pm.response.json();",
									"    var expectedId = pm.collectionVariables.get(\"deviceId\");",
									"    var expectedBasicId = pm.collectionVariables.get(\"basicDeviceId\");",
									"    ",
									"    pm.expect(Array.isArray(jsonData)).to.be.true;",
									"    ",
									"    var foundAdvanced = jsonData.find(m => m.id === expectedId);",
									"    var foundBasic = jsonData.find(m => m.id === expectedBasicId);",
									"    ",
									"    pm.expect(foundAdvanced).to.not.be.undefined;",
									"    pm.expect(foundBasic).to.not.be.undefined;",
									"    pm.expect(foundAdvanced.status).to.eql(\"active\");",
									"    pm.expect(foundBasic.status).to.eql(\"active\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/monitors",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monitors"
							]
						},
						"description": "Lists all active, paused, down, and escalated monitors in the system."
					}
				}
			]
