{
	"info": {
		"_postman_id": "8905391a-7a54-46ab-a02b-2a74c2e68407",
		"name": "Pulse-Check-API Sentinel",
		"description": "Comprehensive Postman Collection for testing the modular Dead Man's Switch API (Watchdog Sentinel). Includes positive workflows, edge cases, automated API key authorization, and validation test scripts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health & Status",
			"item": [
				{
					"name": "Base Route / Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:3000/",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "3000",
							"path": [
								""
							]
						},
						"description": "Checks if the API server is online and returning correct service metadata (does not require auth)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response body matches service info\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"online\");",
									"    pm.expect(jsonData.service).to.eql(\"CritMon Watchdog Sentinel API\");",
									"    pm.expect(jsonData.version).to.eql(\"1.0.0\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "2. Core Operations (Happy Paths)",
			"item": [
				{
					"name": "1. Register Advanced Monitor (Short Timeout)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate a unique device ID to ensure repeatability of the test run without collisions",
									"const uniqueId = 'device-' + Date.now() + '-' + Math.floor(Math.random() * 1000);",
									"pm.collectionVariables.set(\"deviceId\", uniqueId);",
									"console.log(\"Generated dynamic deviceId: \" + uniqueId);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 (Created)\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Monitor registered with correct properties\", function () {",
									"    var jsonData = pm.response.json();",
									"    var expectedId = pm.collectionVariables.get(\"deviceId\");",
									"    ",
									"    pm.expect(jsonData.message).to.eql(\"Monitor registered successfully\");",
									"    pm.expect(jsonData.monitor).to.be.an(\"object\");",
									"    pm.expect(jsonData.monitor.id).to.eql(expectedId);",
									"    pm.expect(jsonData.monitor.timeout).to.eql(10);",
									"    pm.expect(jsonData.monitor.alert_email).to.eql(\"operator@farm.com\");",
									"    pm.expect(jsonData.monitor.webhook_url).to.eql(\"https://httpbin.org/post\");",
									"    pm.expect(jsonData.monitor.backup_email).to.eql(\"lead-engineer@farm.com\");",
									"    pm.expect(jsonData.monitor.status).to.eql(\"active\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"{{deviceId}}\",\n  \"timeout\": 10,\n  \"alert_email\": \"operator@farm.com\",\n  \"webhook_url\": \"https://httpbin.org/post\",\n  \"backup_email\": \"lead-engineer@farm.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/monitors",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monitors"
							]
						},
						"description": "Registers a fully-featured monitor with a short 10-second timeout to test alerts, webhooks, and positive workflows."
					}
				},
				{
					"name": "2. Register Basic Monitor (Defaults)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate a unique basic device ID",
									"const uniqueId = 'basic-' + Date.now() + '-' + Math.floor(Math.random() * 1000);",
									"pm.collectionVariables.set(\"basicDeviceId\", uniqueId);",
									"console.log(\"Generated dynamic basicDeviceId: \" + uniqueId);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 (Created)\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Monitor registered with default timeout and optional fields as null\", function () {",
									"    var jsonData = pm.response.json();",
									"    var expectedId = pm.collectionVariables.get(\"basicDeviceId\");",
									"    ",
									"    pm.expect(jsonData.monitor.id).to.eql(expectedId);",
									"    pm.expect(jsonData.monitor.alert_email).to.eql(\"basic@farm.com\");",
									"    pm.expect(jsonData.monitor.webhook_url).to.be.null;",
									"    pm.expect(jsonData.monitor.backup_email).to.be.null;",
									"    pm.expect(jsonData.monitor.status).to.eql(\"active\");",
									"    pm.expect(jsonData.monitor.timeout).to.be.a(\"number\"); // uses server's DEFAULT_TIMEOUT",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "x-api-key",
								"value": "{{apiKey}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"{{basicDeviceId}}\",\n  \"alert_email\": \"basic@farm.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/monitors",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monitors"
							]
